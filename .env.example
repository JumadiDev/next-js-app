# ============================================================
# SISMOVIGÍA · Variables de entorno
# Copia este archivo a .env y cambia los valores reales.
# NUNCA commitees .env con secretos reales.
# ============================================================

# --- PostgreSQL / TimescaleDB ---
DB_PASSWORD=cambia_esto_por_algo_seguro
POSTGRES_DB=sismovigia
POSTGRES_USER=sismovigia

# Para procesos DENTRO de docker-compose (host = nombre del servicio):
DATABASE_URL=postgresql://sismovigia:${DB_PASSWORD}@db:5432/sismovigia
# Para desarrollo local FUERA de docker, usar:
# DATABASE_URL=postgresql://sismovigia:${DB_PASSWORD}@localhost:5432/sismovigia

# --- Redis (bus de eventos) ---
REDIS_URL=redis://redis:6379/0

# --- MQTT (capa IoT) ---
MQTT_URL=mqtt://mosquitto:1883
MQTT_TOPIC_PREFIX=sismex